# ==============================================================================
# FinLedger VN - Environment Variables Template (.env.example)
# IMPORTANT: Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the actual '.env' containing real secrets to a public repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=finledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Spring Datasource JDBC URL
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ------------------------------------------------------------------------------
# 2. CACHE CONFIGURATION (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. BACKEND APPLICATION CONFIGURATION (Spring Boot 3.3+)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Logging levels
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_FINLEDGER=DEBUG

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="FinLedger VN"
